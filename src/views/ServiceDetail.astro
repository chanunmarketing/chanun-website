---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import YouTube from '../components/YouTube.astro';
import site from '../data/site.json';
import { type Lang, href, pick, priceLabel, ui } from '../lib/i18n';
import { md } from '../lib/md';
import { catName } from '../lib/data';
interface Props { lang: Lang; s: any }
const { lang, s } = Astro.props;
const d = s.data;
const t = ui[lang];
const body = lang === 'en' && d.body_en ? d.body_en : s.body;
const faq = (d.faq ?? []).map((f: any) => ({ q: pick(f, 'q', lang), a: pick(f, 'a', lang) })).filter((f: any) => f.q && f.a);
const faqTitle = lang === 'th' ? 'คำถามที่พบบ่อย' : 'Frequently asked questions';
const summary = pick(d, 'summary', lang);
---
<Base lang={lang} title={pick(d, 'seo_title', lang) || d.name_en} description={summary} image={d.image} jsonld={faq.length ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : undefined}>
  <article class="wrap detail">
    <div class="detail-media">
      <Img src={d.image} alt={d.name_en} ratio="4 / 5" eager />
    </div>
    <div class="detail-body">
      <a class="text-link back" href={href(lang, '/services/')}>{t.back}</a>
      <p class="detail-cat">{catName(d.category)}</p>
      <h1 class="h-page is-latin">{d.name_en}</h1>
      {lang === 'th' && d.name_th && <p class="detail-th">{d.name_th}</p>}
      <p class="lede">{summary}</p>

      {d.price_grid && d.price_grid.rows.length > 0 && (
        <section class="price-box">
          <h2 class="h-small">{t.priceList}</h2>
          <div class={`price-grid ${d.price_grid.columns.length === 1 ? 'pg-single' : ''}`} style={`--cols:${d.price_grid.columns.length}`}>
            <div class="pg-row pg-head" aria-hidden="true">
              <span class="pg-name"></span>
              {d.price_grid.columns.map((c: any) => <span class="pg-col">{lang === 'en' ? c.en : c.th}</span>)}
            </div>
            {d.price_grid.rows.map((r: any) => (
              <div class="pg-row">
                <div class="pg-name">
                  <span class="pg-title">{pick(r, 'name', lang)}</span>
                  {pick(r, 'note', lang) && <span class="pg-note">{pick(r, 'note', lang)}</span>}
                </div>
                {r.cells.map((cell: any, i: number) => (
                  <div class="pg-cell">
                    <span class="pg-label">{lang === 'en' ? d.price_grid.columns[i]?.en : d.price_grid.columns[i]?.th}</span>
                    <span class="pg-price">{/^\d[\d,]*$/.test(cell.price) ? Number(cell.price.replace(/,/g, '')).toLocaleString('en-US') : priceLabel(cell.price, lang)}</span>
                    {pick(cell, 'note', lang) && <span class="pg-sub">{pick(cell, 'note', lang)}</span>}
                  </div>
                ))}
              </div>
            ))}
          </div>
          {pick(d.price_grid, 'footnote', lang) && <p class="pg-foot">{pick(d.price_grid, 'footnote', lang)}</p>}
        </section>
      )}

      {d.prices.length > 0 && (
        <section class="price-box">
          <h2 class="h-small">{t.priceList}</h2>
          <ul class="menu-list compact">
            {d.prices.map((p: any) => (
              <li class="menu-row"><span class="menu-line">
                <span class="menu-name"><span class="menu-item">{pick(p, 'item', lang)}</span>{pick(p, 'note', lang) && <span class="menu-note">{pick(p, 'note', lang)}</span>}</span>
                <span class="menu-leader" aria-hidden="true"></span>
                {p.price !== '-' && <span class={`menu-price ${p.price ? '' : 'is-ask'}`}>{priceLabel(p.price, lang)}</span>}
              </span></li>
            ))}
          </ul>
        </section>
      )}

      <div class="two-notes">
        {pick(d, 'suits', lang) && <div><h2 class="h-small">{t.suits}</h2><p>{pick(d, 'suits', lang)}</p></div>}
        {pick(d, 'avoid', lang) && <div><h2 class="h-small">{t.avoid}</h2><p>{pick(d, 'avoid', lang)}</p></div>}
      </div>

      {body && <div class="prose" set:html={md(body)} />}
      {faq.length > 0 && (
        <section class="faq mt">
          <h2 class="h-small">{faqTitle}</h2>
          {faq.map((f: any) => (
            <details>
              <summary>{f.q}</summary>
              <div set:html={md(f.a)} />
            </details>
          ))}
        </section>
      )}
      {d.youtube && <YouTube url={d.youtube} title={d.name_en} class="mt" />}

      <div class="actions mt">
        <a class="btn btn-solid" href={site.line_url} target="_blank" rel="noopener">{t.book}</a>
        <a class="btn btn-line" href={`tel:${site.phone.replace(/\s/g, '')}`}>{t.call} {site.phone}</a>
      </div>
      <p class="fineprint">{pick(site, 'disclaimer', lang)}</p>
    </div>
  </article>
</Base>
