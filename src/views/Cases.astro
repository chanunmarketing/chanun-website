---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Lightbox from '../components/Lightbox.astro';
import site from '../data/site.json';
import { type Lang, href, pick } from '../lib/i18n';
import { categoryOrder, getCases, getGallery, refToId } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const cases = await getCases();
const gallery = await getGallery();
const muses = cases.filter((c) => c.data.kind === 'muse');
const notes = cases.filter((c) => c.data.kind !== 'muse');
const caseIds = new Set(cases.map((c) => c.id));

const CATS: Record<string, { en: string; th: string }> = {
  lifting: { en: 'Lifting & Contour', th: 'ยกกระชับและปรับกรอบหน้า' },
  skin: { en: 'Skin Quality', th: 'คุณภาพผิว' },
  injectables: { en: 'Injectables', th: 'งานฉีด' },
  scar: { en: 'Acne Scar', th: 'แผลเป็นและหลุมสิว' },
  wellness: { en: 'Inside-Out Wellness', th: 'ดูแลจากภายใน' },
};
const tiles = gallery.flatMap((g) => g.data.images.map((src: string) => ({ src, g })));
const cats = categoryOrder.filter((k) => tiles.some((t) => t.g.data.category === k));

const t = lang === 'th'
  ? {
      intro: 'ทุกผลลัพธ์ที่นี่มีความเฉพาะตัว ชมเคสจริงของ muse และคนไข้ ที่คุณหมอปิงปองออกแบบให้พอดีกับแต่ละคน',
      all: 'ทั้งหมด', muse: 'Muse', approval: 'เลขที่อนุมัติ', read: 'อ่านบันทึกของคุณหมอ',
      galleryNote: 'ผลลัพธ์ขึ้นอยู่กับแต่ละบุคคล ภาพไม่ได้ผ่านการตกแต่ง และได้รับอนุญาตจากผู้รับบริการแล้ว',
      soon: 'แกลเลอรี Before & After กำลังจะมาเร็วๆ นี้',
      muses: 'Muses', musesSub: 'muse ของ CHANUN Clinic กับแผนการดูแลที่ออกแบบเฉพาะแต่ละคน',
      notes: 'Case Notes', notesSub: 'เคสคนไข้ที่ยินยอมให้เล่า โดยไม่เปิดเผยใบหน้า',
    }
  : {
      intro: 'Every result here is one of a kind. See real cases from our muses and patients, each designed by Dr. PP to fit the person.',
      all: 'All', muse: 'Muse', approval: 'Approval no.', read: "Read the doctor's notes",
      galleryNote: 'Results vary from person to person. Images are unretouched and shared with consent.',
      soon: 'The Before & After gallery is coming soon.',
      muses: 'Muses', musesSub: "CHANUN Clinic's muses and the care plans made for each of them",
      notes: 'Case Notes', notesSub: 'Cases shared with patient consent, without showing faces',
    };
const caption = (g: any) =>
  [g.data.program, g.data.person, g.data.treatment_date, g.data.approval_no ? `${t.approval} ${g.data.approval_no}` : ''].filter(Boolean).join(' · ');
const caseLink = (g: any) => {
  const id = refToId(g.data.case);
  return id && caseIds.has(id) ? href(lang, `/atelier-of-muses/${id}/`) : '';
};
---
<Base lang={lang} title="Atelier of Muses" description={t.intro}>
  <section class="page-head sand">
    <div class="wrap">
      <p class="hero-kicker dark">Real Results</p>
      <h1 class="h-page is-latin">Atelier of Muses</h1>
      <p class="lede">{t.intro}</p>
    </div>
  </section>

  <section class="section section-tight" id="before-after">
    <div class="wrap">
      {tiles.length === 0 ? (
        <p class="empty">{t.soon}</p>
      ) : (
        <>
          {cats.length > 1 && (
            <div class="cat-filter" role="group" aria-label="Before & After">
              <button type="button" class="cat-btn" data-gfilter="all" aria-pressed="true"><span class="cat-en">{t.all}</span></button>
              {cats.map((k) => (
                <button type="button" class="cat-btn" data-gfilter={k} aria-pressed="false">
                  <span class="cat-en">{CATS[k]?.en ?? k}</span>
                  <span class="cat-th">{CATS[k]?.th ?? ''}</span>
                </button>
              ))}
            </div>
          )}
          <div class="ba-gallery">
            {tiles.map(({ src, g }) => (
              <figure class="ba-item" data-gcat={g.data.category}>
                <button type="button" class="ba-tile" data-lightbox={src} data-caption={caption(g)}
                  data-link={caseLink(g)} data-link-label={t.read} aria-label={caption(g)}>
                  <img src={src} alt="" loading="lazy" />
                </button>
                <figcaption>
                  <span class="ba-program">{g.data.program}</span>
                  {g.data.person && <span class="ba-person">{g.data.is_muse ? `${t.muse} · ` : ''}{g.data.person}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
          <p class="fineprint">{t.galleryNote}</p>
        </>
      )}
    </div>
  </section>

  {muses.length > 0 && (
    <section class="section sand" id="muses">
      <div class="wrap">
        <div class="section-head-plain">
          <h2 class="h-section is-latin">{t.muses}</h2>
          <p class="muted">{t.musesSub}</p>
        </div>
        <div class="programs">
          {muses.map((c) => (
            <article class="program">
              <a class="program-link" href={href(lang, `/atelier-of-muses/${c.id}/`)}>
                <div class="program-media"><Img src={c.data.portrait} alt={c.data.muse_name || pick(c.data, 'title', lang)} ratio="4 / 5" /></div>
                {c.data.muse_name && <p class="muse-name">{c.data.muse_name}</p>}
                <h3 class="program-title case-title">{pick(c.data, 'title', lang)}</h3>
                {pick(c.data, 'concern', lang) && <p class="program-summary">“{pick(c.data, 'concern', lang)}”</p>}
                <p class="program-price">{t.read}</p>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {notes.length > 0 && (
    <section class="section" id="case-notes">
      <div class="wrap">
        <div class="section-head-plain">
          <h2 class="h-section is-latin">{t.notes}</h2>
          <p class="muted">{t.notesSub}</p>
        </div>
        <ol class="note-list">
          {notes.map((c) => (
            <li>
              <a href={href(lang, `/atelier-of-muses/${c.id}/`)}>
                <h3 class="case-title">{pick(c.data, 'title', lang)}</h3>
                {pick(c.data, 'concern', lang) && <p class="note-quote">“{pick(c.data, 'concern', lang)}”</p>}
                <span class="text-link">{t.read}</span>
              </a>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <div class="wrap"><p class="fineprint">{pick(site, 'disclaimer', lang)}</p></div>
  <Lightbox />
  <script>
    const btns = document.querySelectorAll<HTMLButtonElement>('[data-gfilter]');
    const items = document.querySelectorAll<HTMLElement>('.ba-item');
    const apply = (f: string) => {
      btns.forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.gfilter === f)));
      items.forEach((it) => { it.hidden = !(f === 'all' || it.dataset.gcat === f); });
    };
    btns.forEach((b) => b.addEventListener('click', () => apply(b.dataset.gfilter || 'all')));
    // Allow links like /atelier-of-muses/?category=lifting (e.g. from a programme page)
    const q = new URLSearchParams(location.search).get('category');
    if (q && [...btns].some((b) => b.dataset.gfilter === q)) apply(q);
  </script>
</Base>
