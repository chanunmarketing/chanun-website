---
import Base from '../layouts/Base.astro';
import ServiceCard from '../components/ServiceCard.astro';
import site from '../data/site.json';
import { type Lang, pick, ui } from '../lib/i18n';
import { md } from '../lib/md';
import categoryData from '../data/categories.json';
import { catDesc, catName, categoryOrder, getServices, subgroupsOf } from '../lib/data';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const services = await getServices();
const cats = [...new Set([...categoryOrder, ...services.map((s) => s.data.category)])]
  .map((c) => {
    const items = services.filter((s) => s.data.category === c);
    const defs = subgroupsOf(c);
    const groups = defs.length
      ? [
          ...defs.map((g: any) => ({ id: g.id, name: g.name, desc: lang === 'en' ? g.desc_en || g.desc_th : g.desc_th, items: items.filter((s) => s.data.subgroup === g.id), faq: ((g.faq ?? []) as any[]).map((f) => ({ q: pick(f, 'q', lang), a: pick(f, 'a', lang) })).filter((f) => f.q && f.a) })),
          { id: 'other', name: '', desc: '', faq: [] as { q: string; a: string }[], items: items.filter((s) => !defs.some((g) => g.id === s.data.subgroup)) },
        ].filter((g) => g.items.length || g.id !== 'other')
      : [];
    const faq = (((categoryData.categories as any[]).find((x) => x.id === c)?.faq ?? []) as any[])
      .map((f) => ({ q: pick(f, 'q', lang), a: pick(f, 'a', lang) })).filter((f) => f.q && f.a);
    return { id: c, label: catName(c), desc: catDesc(c, lang), items, groups, faq };
  })
  .filter((c) => c.items.length || categoryOrder.includes(c.id));
const intro = lang === 'th'
  ? 'ทุกโปรแกรมเริ่มจากการออกแบบร่วมกับคุณหมอ เพื่อการดูแลที่พอดีกับคุณ ราคาที่แสดงเป็นราคาเริ่มต้น และปรับตามแผนของแต่ละท่าน'
  : 'Every programme is designed together with the doctor, so your care fits you. Prices shown are starting prices and are adjusted to each plan.';
const ask = lang === 'th'
  ? { text: 'โปรแกรมในหมวดนี้คุณหมอออกแบบให้เฉพาะคนหลังตรวจประเมิน ทัก LINE เพื่อสอบถามรายละเอียดและนัดพบคุณหมอ', btn: 'สอบถามทาง LINE' }
  : { text: 'Programmes in this category are designed for each person after an assessment. Message us on LINE for details or to book a consultation.', btn: 'Ask on LINE' };
---
<Base lang={lang} title={`${t.services} | ${t.servicesSub}`} jsonld={cats.some((c) => c.faq.length || c.groups.some((g: any) => g.faq.length)) ? {
  '@context': 'https://schema.org', '@type': 'FAQPage',
  mainEntity: cats.flatMap((c) => [...c.groups.flatMap((g: any) => g.faq), ...c.faq]).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
} : undefined}>
  <section class="page-head sand">
    <div class="wrap">
      <p class="hero-kicker dark">{t.servicesSub}</p>
      <h1 class="h-page is-latin">{t.services}</h1>
      <p class="lede">{intro}</p>
      <nav class="chips" aria-label={t.services}>
        {cats.map((c) => <a class="chip is-latin" href={`#${c.id}`}>{c.label}</a>)}
      </nav>
    </div>
  </section>
  <div class="wrap services-page">
    {cats.map((c) => (
      <section class="menu-group" id={c.id}>
        <div class="menu-group-head">
          <h2 class="menu-group-title is-latin">{c.label}</h2>
          {c.desc && <p class="muted">{c.desc}</p>}
        </div>
        {c.groups.length > 0 ? (
          c.groups.map((g) => (
            <div class="menu-sub" id={`${c.id}-${g.id}`}>
              {g.name && (
                <div class="menu-sub-head">
                  <h3 class="menu-sub-title is-latin">{g.name}</h3>
                  {g.desc && <p class="muted">{g.desc}</p>}
                </div>
              )}
              {g.items.length > 0 ? (
                <div class="programs programs-3">{g.items.map((s) => <ServiceCard s={s} lang={lang} />)}</div>
              ) : (
                <div class="menu-ask menu-ask-sm">
                  <p>{ask.text}</p>
                  <a class="btn btn-ghost btn-sm" href={site.line_url} target="_blank" rel="noopener">{ask.btn}</a>
                </div>
              )}
              {g.faq.length > 0 && (
                <div class="faq menu-faq menu-faq-sub">
                  <p class="menu-faq-label">{lang === 'th' ? `${g.name} · คำถามที่พบบ่อย` : `${g.name} · FAQ`}</p>
                  {g.faq.map((f: any) => (
                    <details>
                      <summary>{f.q}</summary>
                      <div set:html={md(f.a)} />
                    </details>
                  ))}
                </div>
              )}
            </div>
          ))
        ) : c.items.length > 0 ? (
          <div class="programs programs-3">{c.items.map((s) => <ServiceCard s={s} lang={lang} />)}</div>
        ) : (
          <div class="menu-ask">
            <p>{ask.text}</p>
            <a class="btn btn-ghost btn-sm" href={site.line_url} target="_blank" rel="noopener">{ask.btn}</a>
          </div>
        )}
        {c.faq.length > 0 && (
          <div class="faq menu-faq">
            <h3 class="menu-sub-title is-latin">{lang === 'th' ? `${c.label} · คำถามที่พบบ่อย` : `${c.label} · FAQ`}</h3>
            {c.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <div set:html={md(f.a)} />
              </details>
            ))}
          </div>
        )}
      </section>
    ))}
    <p class="fineprint">{pick(site, 'disclaimer', lang)}</p>
  </div>
</Base>
